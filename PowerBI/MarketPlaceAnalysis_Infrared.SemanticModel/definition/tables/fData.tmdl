	measure 'Header Color' =
			
			VAR BrandRank = RANKX(ALLSELECTED(fData[品牌]), [月销售额], , DESC)
			RETURN
			IF(BrandRank <= 10, "#FF4500", "#118DFF")
		displayFolder: Measures
		lineageTag: f5de5f43-c57b-4258-94a8-5819a5b8f84d

	measure 累计销售额 =
			
			VAR CurrentBrandTable = ALLSELECTED(fData[品牌]) -- 获取当前选中的所有品牌
			RETURN
			    SUMX(
			        WINDOW(
			            1, ABS,                -- 从排序后的第1行开始
			            0, REL,                -- 累加到当前行
			            CurrentBrandTable,      -- 数据范围
			            ORDERBY([月销售额], DESC) -- 核心：按销售额从高到低排序
			        ),
			        [月销售额]
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures
		lineageTag: a23c0e2a-7cc9-4779-acd2-41d06f13e5d2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 帕累托累计占比 =
			
			VAR TotalMarketRevenue = CALCULATE([月销售额], ALLSELECTED(fData))
			RETURN
			    DIVIDE([累计销售额], TotalMarketRevenue)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures
		lineageTag: 1b1dbc89-b46e-4e37-8017-7e8ddf29a209

