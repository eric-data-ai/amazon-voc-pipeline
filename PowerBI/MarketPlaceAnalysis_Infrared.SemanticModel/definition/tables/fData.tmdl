				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded GetData",{{"Product", type text}, {"ASIN", type text}, {"品牌", type text}, {"商品标题", type text}, {"产品卖点", type text}, {"父ASIN", type text}, {"类目路径", type text}, {"大类目", type text}, {"大类BSR", Int64.Type}, {"大类BSR增长数", Int64.Type}, {"大类BSR增长率", Percentage.Type}, {"小类目", type text}, {"小类BSR", Int64.Type}, {"月销量", Int64.Type}, {"月销量增长率", Percentage.Type}, {"月销售额($)", Int64.Type}, {"子体销量", Int64.Type}, {"子体销售额($)", type number}, {"变体数", Int64.Type}, {"价格($)", type number}, {"Q&A数", Int64.Type}, {"评分数", Int64.Type}, {"月新增评分数", Int64.Type}, {"评分", type number}, {"留评率", Percentage.Type}, {"FBA($)", type number}, {"毛利率", Percentage.Type}, {"上架时间", type date}, {"上架天数", Int64.Type}, {"配送方式", type text}, {"买家运费($)", type number}, {"LQS", type number}, {"卖家数", Int64.Type}, {"卖家所属地", type text}, {"Best Seller标识", type text}, {"Amazon's Choice", type text}, {"CPF绿标", type text}, {"CPF绿标信息", type text}, {"New Release标识", type text}, {"A+页面", type text}, {"视频介绍", type text}, {"SP广告", type text}, {"品牌故事", type text}, {"品牌广告", type text}, {"7天促销", type text}, {"商品重量", type text}, {"商品重量（单位换算）", type text}, {"商品尺寸", type text}, {"商品尺寸（单位换算）", type text}, {"包装重量", type text}, {"包装重量（单位换算）", type text}, {"包装尺寸", type text}, {"包装尺寸（单位换算）", type text}, {"包装尺寸分段", type text}}),
