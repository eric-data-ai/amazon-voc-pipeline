				    #"Added Conditional Column" = Table.AddColumn(#"Lowercased Text1", "IsInfrared", each if Text.Contains([TitleBullets], "far infrared") or Text.Contains([TitleBullets], "far-infrared") then "FIR" else if Text.Contains([TitleBullets], "red light") or Text.Contains([TitleBullets], "red-light") then "RLT" else if Text.Contains([TitleBullets], "infrared") then "Infrared_Only" else "Other", type text),
				    #"Added Custom1" = Table.AddColumn(#"Added Conditional Column", "Cat", each fxMatchType([商品标题], [Product], dCat, "人类"), type text),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Parts", each if [Product] = "Cervical" then "肩颈部" else fxMatchType([商品标题], [Product], dParts, "全身"), type text),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Pattern", each fxMatchType([商品标题], [Product], dPattern, "其它"), type text),
				    #"Added Conditional Column1" = Table.AddColumn(#"Added Custom3", "价格区间", each 
				    if [#"价格($)"] < 50 then "a.$50以下" 
				    else if [#"价格($)"] < 100 then "b.$50-100" 
				    else if [#"价格($)"] < 150 then "c.$100-150" 
				    else if [#"价格($)"] < 200 then "d.$150-200"
				    else if [#"价格($)"] < 250 then "e.$200-250"
				    else if [#"价格($)"] < 300 then "f.$250-300" 
				    else "g.$300以上",
				    type text
