		lineageTag: 969ac7b2-b61c-4d46-a0c1-00d03e1d7abd

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% MoSales' =
			
			DIVIDE(
			    [月度销量],
			    CALCULATE(
			        [月度销量],
			        ALL(fData[品牌])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures
		lineageTag: d68fff6d-c87d-42d4-bc49-d50753169add

	measure '% MoRevenue' =
			
			DIVIDE(
			    [月销售额],
			    CALCULATE(
			        [月销售额],
			        ALL(fData[品牌])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures
		lineageTag: d76dc34d-ffc8-46df-817d-81daa0fffbbf

	measure 'Is Top Brand Sales' = ```
			
			-- 1. 无论在矩阵的哪一行，都先拿到当前切片器过滤后的完整品牌销量表
			VAR VirtualBrandTable = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES(fData[品牌]),
			            "@Sales", [月度销量]
			        ),
			        ALLSELECTED(fData[品牌])
			    )
			
			-- 2. 统计总品牌数
			VAR TotalBrands = COUNTROWS(VirtualBrandTable)
			
			-- 3. 获取当前行品牌的销量
			VAR CurrentSales = [月度销量]
			
			-- 4. 计算当前品牌在虚拟表中的排名
			VAR BrandRank = 
			    IF(
			        CurrentSales > 0,
			        RANKX(VirtualBrandTable, [@Sales], CurrentSales, DESC, Dense)
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(BrandRank) && (BrandRank <= 5 || DIVIDE(BrandRank, TotalBrands) <= 0.05),
			        1, 0
			    )
			```
		formatString: 0
		displayFolder: Measures
		lineageTag: c0a72c47-d899-4f21-be9e-8a67cbbae972

	measure 'Top Brand Count' =
			
			SUMX(
			    VALUES(fData[品牌]),
			    [Is Top Brand Sales]
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: f77ea184-0ac3-4f0a-92b8-e1ba42827352

	measure 头部品牌销售额占比 = ```
			
			-- 1. 计算当前切片器（如红外产品）下的总销售额（分母）
			VAR TotalMarketRev = [月销售额] 
			
			-- 2. 计算那 8 个头部品牌的销量总和（分子）
			VAR TopBrandRev = 
			    CALCULATE(
			        [月销售额],
			        FILTER(
			            ALLSELECTED(fData[品牌]),
			            [Is Top Brand Rev] = 1
			        )
			    )
			
			-- 3. 计算占比
			RETURN 
			    DIVIDE(TopBrandRev, TotalMarketRev)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures
		lineageTag: 75f55ac3-b2bb-46a0-a80b-fd3d448c37cf

	measure 'Is Top Brand Rev' = ```
			
			-- 1. 构建虚拟表，抓取品牌对应的销售额
			VAR VirtualBrandTable = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES(fData[品牌]),
			            "@Rev", [月销售额]
			        ),
			        ALLSELECTED(fData[品牌])
			    )
			
			-- 2. 统计总品牌数
			VAR TotalBrands = COUNTROWS(VirtualBrandTable)
			
			-- 3. 获取当前行品牌的销售额
			VAR CurrentRev = [月销售额]
			
			-- 4. 计算排名（注意：这里必须全部使用 Rev 相关的变量）
			VAR BrandRank = 
			    IF(
			        CurrentRev > 0, -- 修正点 1: 检查销售额是否大于 0
			        RANKX(VirtualBrandTable, [@Rev], CurrentRev, DESC, Dense) -- 修正点 2: 使用 CurrentRev 比较
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(BrandRank) && (BrandRank <= 5 || DIVIDE(BrandRank, TotalBrands) <= 0.05),
			        1, 0
			    )
			```
		formatString: 0
		displayFolder: Measures
		lineageTag: 2f066672-0caa-443f-9b29-faebe3df5a91

	measure 平均单价 = AVERAGE(fData[价格($)])
