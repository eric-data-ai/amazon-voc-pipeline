table fData
	lineageTag: 07891ae7-5137-4d0d-a6b8-f23ff35405fb

	measure 月度销量 = ```
			
			VAR TblByAsin = 
			    SUMMARIZE(
			        fData,
			        fData[品牌],
			        fData[父ASIN],
			        "MSales",
			        MAX(fData[月销量])
			    )
			VAR Sales = 
			    SUMX(
			        TblByAsin,
			        [MSales]
			    )
			RETURN
			    Sales
			```
		formatString: 0
		displayFolder: Measures
		lineageTag: 9b3e62fe-1b32-44ea-a3b6-75c859cc5765

	measure 月销售额 = ```
			
			VAR TblByAsin = 
			    SUMMARIZE(
			        fData,
			        fData[品牌],
			        fData[父ASIN],
			        "MRev",
			        MAX(fData[月销售额($)])
			    )
			VAR Sales = 
			    SUMX(
			        TblByAsin,
			        [MRev]
			    )
			RETURN
			    Sales
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Measures
		lineageTag: c5832282-a9da-4957-80ff-4ea132c0196b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 品牌数 = DISTINCTCOUNT(fData[品牌])
		formatString: 0
		displayFolder: Measures
		lineageTag: 36895da3-4b3a-49e4-b9d4-248d92df568b

	measure 头部品牌销量占比 = ```
			
			-- 1. 计算当前切片器（如红外产品）下的总销量（分母）
			VAR TotalMarketSales = [月度销量] 
			
			-- 2. 计算那 8 个头部品牌的销量总和（分子）
			VAR TopBrandSales = 
			    CALCULATE(
			        [月度销量],
			        FILTER(
			            ALLSELECTED(fData[品牌]),
			            [Is Top Brand Sales] = 1
			        )
			    )
			
			-- 3. 计算占比
			RETURN 
			    DIVIDE(TopBrandSales, TotalMarketSales)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures
		lineageTag: 66b57d58-6763-4eaf-ab20-257bf3bf681f

	measure 销售额排名 =
			
			IF(
			    HASONEVALUE(fData[品牌]),
			    RANKX(ALLSELECTED(fData[品牌]), [月销售额])
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: f1aed0a2-8f63-4453-b40e-9a89e0fa10d8

	measure 中位数价格 = MEDIAN(fData[价格($)])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
