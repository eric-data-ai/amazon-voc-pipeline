	measure 上架时间M = ```
			
			VAR TblByAsin = 
			    FILTER(
			        SUMMARIZE(
			            fData,
			            fData[品牌],
			            fData[父ASIN],
			            "ListingDate", MIN(fData[上架时间])
			        ),
			        NOT ISBLANK([ListingDate]) && [ListingDate] > DATE(2000,1,1) // 排除空值和可能的异常脏数据
			    )
			VAR MedianDateNum = 
			    MEDIANX(
			        TblByAsin,
			        INT([ListingDate]) 
			    )
			RETURN
			    CONVERT(MedianDateNum, DATETIME)
			```
		formatString: mm/dd/yyyy
		displayFolder: Measures
		lineageTag: e1d82f46-5527-4e55-9a31-5361102faa2b

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 上架天数M = ```
			
			VAR TblByAsin = 
			    CALCULATETABLE(
			        SUMMARIZE(
			            fData,
			            fData[品牌],
			            fData[父ASIN],
			            "MaxDaysPerAsin", ROUNDUP(MAX(fData[上架天数]), 0)
			        ),
			        -- 强制忽略外部对 IsInfrared 和 Product 的特定筛选，确保读取该品牌所有 ASIN
			        ALL(fData[IsInfrared], fData[Product]),
			        NOT ISBLANK(fData[上架天数])
			    )
			RETURN
			    MEDIANX(
			        TblByAsin,
			        [MaxDaysPerAsin]
			    )
			```
		displayFolder: Measures
		lineageTag: d7311ac9-5709-4957-a633-5d0551ae30d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 评论数 = ```
			
			VAR TblByAsin = 
			    SUMMARIZE(
			        fData,
			        fData[品牌],
			        fData[父ASIN],
			        "ReviewCount",
			        MAX(fData[评分数])
			    )
			VAR TotalReviews = 
			    SUMX(
			        TblByAsin,
			        [ReviewCount]
			    )
			RETURN
			    TotalReviews
			```
		formatString: 0
		displayFolder: Measures
		lineageTag: afee3438-b439-443b-a0e0-bf8908951bc9

	measure 'Bar Color' =
			
			VAR RankPart =
			    RANKX(
			        ALLSELECTED(fData[Parts]),
			        [月销售额],
			        ,
			        DESC
			    )
			
			VAR RankBrand =
			    RANKX(
			        ALLSELECTED(fData[品牌]),
			        [月销售额],
			        ,
			        DESC
			    )
			
			RETURN
			IF(
			    ISINSCOPE(fData[品牌]),
			    IF(RankBrand <= 3,"#B85C38","#D8D0C8"),
			    IF(RankPart <= 3,"#B85C38","#D8D0C8")
			)
		displayFolder: Measures
		lineageTag: 20a1d9f0-c4f5-4be4-93c5-a148adc95f7b

