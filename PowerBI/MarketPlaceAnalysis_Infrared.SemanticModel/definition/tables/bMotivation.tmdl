		lineageTag: 6073e946-00b4-458d-b4fe-61bd2fce3c2d
		summarizeBy: none
		sourceColumn: Motivation_Main

		annotation SummarizationSetBy = Automatic

	column Motivation_Source
		dataType: string
		lineageTag: af0fcf74-8ba9-4681-83e4-e86ae3f5b551
		summarizeBy: none
		sourceColumn: Motivation_Source

		annotation SummarizationSetBy = Automatic

	column Motivation_Score
		dataType: double
		lineageTag: 1103b19b-778f-4d7d-86af-9a340966da0c
		summarizeBy: sum
		sourceColumn: Motivation_Score

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Motivation_Margin
