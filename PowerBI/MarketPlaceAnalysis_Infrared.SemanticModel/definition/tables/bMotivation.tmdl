		lineageTag: d52198ed-2309-4c04-97cb-24bb53c5d16c
		summarizeBy: sum
		sourceColumn: Motivation_Margin

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition bMotivation = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([Implementation="2.0"]),
				    #"amazon-voc-pipeline_Database" = Source{[Name="amazon-voc-pipeline",Kind="Database"]}[Data],
				    voc_features_Schema = #"amazon-voc-pipeline_Database"{[Name="voc_features",Kind="Schema"]}[Data],
				    motivation_bridge_Table = voc_features_Schema{[Name="motivation_bridge",Kind="Table"]}[Data]
				in
				    motivation_bridge_Table

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

