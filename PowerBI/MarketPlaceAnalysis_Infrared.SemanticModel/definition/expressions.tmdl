expression fxMatchType = ```
		(CurrentTitle as any, CurrentProduct as any, MappingTable as table, Unmatched as any) as any =>
		let
		    
		    SafeTitle = Text.Trim(Text.From(CurrentTitle ?? "")), 
		
		    
		    SafeProduct = Text.Trim(Text.From(CurrentProduct ?? "")),
		    
		    
		    FilteredRows = Table.SelectRows(MappingTable, each 
		        [Product] = SafeProduct and 
		        Text.Contains(SafeTitle, [Term])
		    ),
		    
		    Match = Table.First(FilteredRows),
		    Result = if Match = null then Unmatched else Match[Type]
		in
		    Result
		```
	lineageTag: 5311a900-8d60-4c3f-a4e5-eae66ce86d05

	annotation PBI_NavigationStepName = Navigation

